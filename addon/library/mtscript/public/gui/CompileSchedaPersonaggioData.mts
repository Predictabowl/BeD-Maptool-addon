[h: tokenId = arg(0)]

[h: switchToken(tokenId)]

[h: jData = "{}"]
[h: iVA = getVA(tokenId)]
[h: iMancare = getMancare(tokenId)]
[h: jData = json.set("", "va", iVA, "tempoPercent", round(calcPercentMod(-iVA/100)*100,1), "mancare", iMancare, "mancarePercent", round(getMancareProb(iMancare)*100,1))]
[h: jData =json.set(jData, "ld_t", getLD(tokenId, "T"), "ld_b", getLD(tokenId, "B"), "ld_p", getLD(tokenId, "P"))]
[h: iSchivare = getSchivare(tokenId)]
[h: iParare = getParare(tokenId)]
[h: jData =json.set(jData, "schivare", iSchivare, "schivarePercent", strformat("%.1f", getSchivareProb(iSchivare)*100), "parare", iParare, "pararePercent", strformat("%.1f", getParareProb(iParare)*100))]
[h: jData =json.set(jData, "elusione", getElusione(tokenId), "ts_rif", strformat("%+d", getTSRiflessi(tokenId)), "ts_tem", strformat("%+d", getTSTempra(tokenId)), "ts_vol", strformat("%+d", getTSVolonta(tokenId)))]
[h: jData =json.set(jData, "res_acqua",getResistance(json.set("", "target", tokenId, "elemento", "Acqua")))]
[h: jData =json.set(jData, "res_aria",getResistance(json.set("", "target", tokenId, "elemento", "Aria")))]
[h: jData =json.set(jData, "res_fuoco",getResistance(json.set("", "target", tokenId, "elemento", "Fuoco")))]
[h: jData =json.set(jData, "res_terra",getResistance(json.set("", "target", tokenId, "elemento", "Terra")))]
[h: jData =json.set(jData, "res_arcano",getResistance(json.set("", "target", tokenId, "elemento", "Arcano")))]
[h: jData =json.set(jData, "res_mentale",getResistance(json.set("", "target", tokenId, "elemento", "Mentale")))]
[h: jData =json.set(jData, "res_negativo",getResistance(json.set("", "target", tokenId, "elemento", "Negativo")))]
[h: jData =json.set(jData, "res_positivo",getResistance(json.set("", "target", tokenId, "elemento", "Positivo")))]
[h: jData =json.set(jData, "res_fisico",getResistance(json.set("", "target", tokenId, "elemento", "Fisico")))]

[h: jData =json.set(jData, "iniziativa", strformat("1d24%+d",Tiro_Iniziativa), "mov_time", getMoveTime(tokenId), "concentrazione", getConcentrazionePoteri(tokenId), "perturbazione", strformat("1d100%+d",getPerturbazionePoteri(tokenId)))]
[h, macro("core/getMDIPerc@this"): tokenId]
[h: jData =json.set(jData, "mdi", strformat("%+.1f", (calcPercentMod(macro.return)-1)*100))]
[h: jData =json.set(jData, "mdr", strformat("%+.1f", (calcPercentMod(Mod_Danno_in)-1)*100))]
[h, macro("core/getMCGPerc@this"): tokenId]
[h: jData =json.set(jData, "mcg", strformat("%+.1f", (calcPercentMod(macro.return)-1)*100))]
[h: jData =json.set(jData, "mcr", strformat("%+.1f", (calcPercentMod(Mod_Cura_in)-1)*100))]
[h: oStili = data.getStaticData("it.aldinucci.piero.bed.maptool.ruleset", "public/db/config/stili.json")]
[h: jData = json.set(jData, "stile", json.path.read(oStili, Stile+ ".name"))]

[h: return(0, jData)]