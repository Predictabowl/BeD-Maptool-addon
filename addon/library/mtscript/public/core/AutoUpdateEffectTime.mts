[h: target = arg(0)]
[h: mod = arg(1)]
[h, if(argCount() > 2): sFilter = arg(2); sFilter = ""]

[h, macro("setRoundUpdating@Lib:MetodiVari"):1]

[h: switchToken(target)]
[h, if(json.isEmpty(Lista_Effetti) == 1): Lista_Effetti= "{}"]

[r, foreach(effetto,Lista_Effetti,""), code:{
	[h: subList = json.get(Lista_Effetti,effetto)]
	[h, if (json.isEmpty(subList) == 1):  iDurata = 0;   iDurata = json.get(subList,"durata")]
	[macro("core/CalcDurata@this"): json.set("","durata",iDurata,"mod",mod)]
	[h: iDurata = macro.return]
	[h, macro("core/isEffectAutoGenerated@this"): subList]
	[h: bSkip = macro.return]

	[h, if(bSkip), code:{
		[subList = json.set(subList,"roundUpdating",0)]
		[Lista_Effetti = json.set(Lista_Effetti,effetto, subList)]
	}]

	[h, if(sFilter == "SKIP_PROTECTED"), code:{
		[sTipo = upper(json.get(subList,"tipo"))]
		[if(sTipo == "PROTETTO"): bSkip = 1]
	}]
	
	[h: param = json.append(target,effetto)]

	[r, if(iDurata == 0 && !bSkip), code:{
		[r, macro("core/endRoundProcessEffect@this"):param]
		[r, macro("core/RemoveEffect@this"):param]
		[h: broadcast(macro.return)]
	};{}]
	[r, if(iDurata != 0 && !bSkip), code:{
		[h: subList = json.set(subList,"durata",iDurata)]
		[h: Lista_Effetti = json.set(Lista_Effetti,effetto, subList)]
		[r, macro("core/ProcessEffect@this"):param]
	};{}]
}]
[h, macro("setRoundUpdating@Lib:MetodiVari"):0]